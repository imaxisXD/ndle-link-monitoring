  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.61.1",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "prettier": "^3.7.4"
  },
  "overrides": {
    "esbuild": "0.28.1",
