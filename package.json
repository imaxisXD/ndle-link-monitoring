{
  "name": "ndle-link-monitoring",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun test",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "bunx drizzle-kit push",
    "start": "bun run db:migrate && bun run src/index.ts"
  },
  "dependencies": {
    "@sentry/bun": "^10.78.0",
    "bullmq": "^5.81.6",
    "convex": "^1.51.0",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.32",
    "file-type": "22.3.0",
    "ioredis": "^5.11.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "bun-types": "^1.4.5",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "file-type": "22.3.0",
    "ws": "8.21.0"
  }
}
