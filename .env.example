# PostgreSQL connection
DATABASE_URL=

# Redis connection (for BullMQ)
REDIS_URL=

# Convex
CONVEX_URL_DEV=
CONVEX_URL_PROD=

# Shared secrets for API auth
MONITORING_API_SECRET=your-api-secret-here
MONITORING_SHARED_SECRET=your-shared-secret-for-convex

# Sentry (optional)
SENTRY_DSN=

# Component toggles (both default to true; the API always runs)
RUN_SCHEDULER=true
RUN_WORKER=true

# Performance tuning
WORKER_CONCURRENCY=10
SCHEDULER_INTERVAL_MS=10000
SCHEDULER_BATCH_SIZE=500
CHECK_TIMEOUT_MS=10000
DEGRADED_THRESHOLD_MS=3000
LOG_LEVEL=info

# Server port
PORT=3001

# Comma-separated environments handled by this worker (prod by default)
MONITORING_ENVIRONMENTS=prod
